// Read model only. The panel owns DDL. Never run db push/migrate/reset here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  schemas = ["placas"]
}

enum StatusPlaca {
  ESTOQUE
  DISPONIVEL
  ATIVA
  INATIVA
  @@schema("placas")
}

enum TipoPlaca {
  GOOGLE
  PIX
  WIFI
  SITE
  @@schema("placas")
}

enum StatusBotLog {
  SUCESSO
  ERRO
  @@schema("placas")
}

model Contrato {
  id String @id
  nomeEmpresa String
  telefoneContato String?
  ativo Boolean
  placas Placa[]
  @@schema("placas")
}

model Placa {
  id String @id
  codigo String? @unique
  tipo TipoPlaca
  nomeEmpresa String?
  placeId String?
  status StatusPlaca
  botAtivo Boolean
  telefoneWhatsapp String?
  contratoId String?
  contrato Contrato? @relation(fields: [contratoId], references: [id])
  botLogs BotLog[]
  @@schema("placas")
}

model BotLog {
  id String @id @default(cuid())
  placaId String
  placa Placa @relation(fields: [placaId], references: [id])
  enviadoEm DateTime @default(now())
  status StatusBotLog
  resumo String @db.Text
  erro String? @db.Text
  @@schema("placas")
}

model PanelDatabaseIdentity {
  id Int @id
  application String
  instanceId String @unique
  createdAt DateTime @default(now())
  @@schema("placas")
}
